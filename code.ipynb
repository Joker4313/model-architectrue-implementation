   "source": [
    "def sqrt_by_gradient_descent():\n",
    "    x = 2.0\n",
    "    lr = 1e-3\n",
    "    epochs=400\n",
    "\n",
    "    for _ in range(epochs):\n",
    "        gradient = 4 * x * (x*x - 3)\n",
    "        x -= lr * gradient\n",
    "\n",
    "    return round(x, 3)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "be9d8ed6",
   "metadata": {},
